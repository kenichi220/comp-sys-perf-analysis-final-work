++ echo '"poti2:29500","poti5:29500"'
+ LIST='"poti2:29500","poti5:29500"'
+ export LIST
+ srun '--export=ALL,SCRATCH=/scratch/rrdmatos,worker_list="poti2:29500","poti5:29500"' bash -c '
