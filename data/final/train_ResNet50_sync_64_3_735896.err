poti3'
+ nodes_array=($nodes)
+ MASTER_PORT=29500
+ worker_list=
+ for node in "${nodes_array[@]}"
+ worker_list+='"poti1:29500",'
+ for node in "${nodes_array[@]}"
+ worker_list+='"poti2:29500",'
+ for node in "${nodes_array[@]}"
+ worker_list+='"poti3:29500",'
