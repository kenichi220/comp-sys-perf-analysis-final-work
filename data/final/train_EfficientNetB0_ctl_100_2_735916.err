+ mkdir -p /home/users/rrdmatos/logs
+ echo 'Create TF_CONFIG'
++ scontrol show hostnames 'poti[2,5]'
+ nodes='poti2
poti5'
+ nodes_array=($nodes)
+ MASTER_PORT=29500
+ worker_list=
+ for node in "${nodes_array[@]}"
+ worker_list+='"poti2:29500",'
+ for node in "${nodes_array[@]}"
+ worker_list+='"poti5:29500",'
+ worker_list='"poti2:29500","poti5:29500"'
++ echo '"poti2:29500","poti5:29500"'
+ LIST='"poti2:29500","poti5:29500"'
+ export LIST
+ srun '--export=ALL,SCRATCH=/scratch/rrdmatos,worker_list="poti2:29500","poti5:29500"' bash -c '
# This block of code is executed by each Slurm task on its respective node
echo "--- Running setup on $(hostname) ---"
cd $SCRATCH

rm -r *

cp -r ~/perf/tensorflow/create-env.sh ~/perf/tensorflow/train-* .
DATA_DIR="tiny-imagenet-200"

wget http://cs231n.stanford.edu/tiny-imagenet-200.zip
unzip -q *.zip

.  ./create-env.sh
'
