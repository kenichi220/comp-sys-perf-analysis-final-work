+ scontrol show hostnames 'poti[1-3]'
+ echo 'All nodes finished setup.'
+ TO_RUN=train-sync.py
+ '[' sync == ctl ']'
+ env
++ pwd
+ HOME=/home/users/rrdmatos/perf/tensorflow
+ srun '--export=ALL,SCRATCH=/scratch/rrdmatos,TO_RUN=train-sync.py,HOME=/home/users/rrdmatos/perf/tensorflow,LIST="poti1:29500","poti2:29500","poti3:29500"' bash -c '

cd $SCRATCH
source venv/bin/activate

TF_CONFIG=$(cat <<EOF
{
    "cluster": {
        "worker": [$LIST]
    },
    "task": {
        "type": "worker",
        "index": ${SLURM_PROCID}
    }
}
EOF
)
export TF_CONFIG

env

echo "Host: $(hostname) | Rank (PROCID): ${SLURM_PROCID} | TF_CONFIG: ${TF_CONFIG}"

echo "$TO_RUN,$PY_MODEL\n"
python $TO_RUN --model $PY_MODEL --batch $PY_BATCH_SIZE

LOGS_DIR="$HOME/logs/${TO_RUN}_${SLURM_JOB_ID}/${SLURM_PROCID}/"

mkdir -p $LOGS_DIR
cp $SCRATCH/*logs*/ $LOGS_DIR -r
'
