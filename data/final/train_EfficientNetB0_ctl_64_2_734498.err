++ echo '"poti3:29500","poti4:29500"'
+ LIST='"poti3:29500","poti4:29500"'
+ export LIST
+ srun '--export=ALL,SCRATCH=/scratch/rrdmatos,worker_list="poti3:29500","poti4:29500"' bash -c '
