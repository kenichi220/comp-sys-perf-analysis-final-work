++ echo '"poti2:29500","poti3:29500","poti4:29500"'
+ LIST='"poti2:29500","poti3:29500","poti4:29500"'
+ export LIST
+ srun '--export=ALL,SCRATCH=/scratch/rrdmatos,worker_list="poti2:29500","poti3:29500","poti4:29500"' bash -c '
# This block of code is executed by each Slurm task on its respective node
echo "--- Running setup on $(hostname) ---"
cd $SCRATCH

rm -r *

cp -r ~/perf/tensorflow/create-env.sh ~/perf/tensorflow/train-* .
