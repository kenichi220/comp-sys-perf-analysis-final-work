+ mkdir -p /home/users/rrdmatos/logs
+ echo 'Create TF_CONFIG'
++ scontrol show hostnames 'poti[1,3]'
+ nodes='poti1
poti3'
+ nodes_array=($nodes)
+ MASTER_PORT=29500
+ worker_list=
