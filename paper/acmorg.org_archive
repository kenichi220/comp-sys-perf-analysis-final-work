options(crayon.enabled=FALSE)
suppressMessages(library(fs))
suppressMessages(library(tidyverse))
suppressMessages(library(janitor))
suppressMessages(library(dplyr))
suppressMessages(library(lubridate))

BASE="data/final/"
tibble(PATH = dir_ls(BASE, regexp = "out$", recurse=TRUE))  |>
  ## filter(!str_detect(CSV, ":")) |>
  ## filter(!str_detect(CSV, "ep")) |>
  ## mutate(DATA = map(CSV, read_csv, progress=FALSE, show_col_types = FALSE)) |>
  separate(PATH, into=paste0("XX", 1:3), sep="/") |>
  separate(XX3, into=paste0("YY", 1:6), sep="_") |>
  ## mutate(type=XX4) |> #|>
  mutate(YY6 = gsub("\\.out", "", YY6)) |>
  ## mutate(machine = gsub("\\-.*", "", machine)) |>
  ## rowid_to_column("id") |>
  select(id=YY6, model=YY2, batch=YY4, type=YY3, nodes=YY5) -> configs

configs
#+end_src

